<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwConfigExceptions="true" >

    <!-- Use when necessary for debugging NLog config issues: -->
    <!-- <internalLogLevel>Trace</internalLogLevel> -->
    <!-- <internalLogFile>internal-nlog.txt</internalLogFile> -->

    <extensions>
        <add assembly="NLog.Targets.OpenTelemetryProtocol" />
    </extensions>

    <variable name="LogDirectory" value="${configsetting:item=NLog.LogDirectory}" />
    <variable name="MinLogLevel" value="${configsetting:item=NLog.MinLogLevel}" />

    <targets async="true">
        <target xsi:type="File"
                name="file"
                fileName="${LogDirectory}/${shortdate}.log"
                layout="${longdate} ${date:universalTime=true} ${callsite:className=true:methodName=true} ${event-properties:item=EventId} ${event-properties:item=ErrorCode} ${level:uppercase=true} ${message} ${exception:format=ToString,StackTrace}"
                archiveFileName="${LogDirectory}/archive/{#}.log"
                archiveNumbering="Sequence"
                archiveEvery="Day"
                maxArchiveFiles="7"
                archiveAboveSize="10485760" /> <!-- 10MB in Bytes -->

        <target xsi:type="ColoredConsole"
                name="console"
                layout="${longdate} ${event-properties:item=EventId} ${date:universalTime=true} ${callsite:className=true:methodName=true} ${event-properties:item=ErrorCode} ${level:uppercase=true} ${message} ${exception:format=ToString,StackTrace}" />

        <target xsi:type="OtlpTarget"
                name="otel"
                endpoint="http://server:4317"
                servicename="DQRetro.TournamentTracker.Api"
                usehttp="false"
                includeEventProperties="true"
                includeFormattedMessage="true" />
    </targets>

    <rules>
        <logger name="*" minlevel="${MinLogLevel}" writeTo="file,console,otel" />
    </rules>
</nlog>
